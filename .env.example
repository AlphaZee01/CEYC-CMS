# Copy to .env and change in production
JWT_SECRET=your-secure-random-secret-here
PORT=3001
SEED_PASSWORD=ChangeMe123!
APP_URL=http://localhost:8080
CHURCH_NAME=Christ Embassy LCM

# SQLite (default) — leave DATABASE_URL empty
# DATABASE_URL=

# PostgreSQL / Supabase — set to use cloud database instead of data/church.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_SSL=true

# SMTP — password reset & optional task notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourchurch.org
SMTP_NOTIFY=true

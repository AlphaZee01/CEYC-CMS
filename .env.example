# Copy to .env and change in production
JWT_SECRET=your-secure-random-secret-here
PORT=3001
SEED_PASSWORD=ChangeMe123!
APP_URL=http://localhost:8080
# Production (Vercel): https://your-app.vercel.app
CHURCH_NAME=Christ Embassy Airport City Jesus Brand

# ── Database (Supabase Postgres — required) ───────────────────────────────────
# Pick ONE:
#   A) Full URI: DATABASE_URL=postgresql://...  (Dashboard → Database → Connection string)
#   B) Password only: USE_SUPABASE_DB=true + SUPABASE_DB_PASSWORD + SUPABASE_PROJECT_REF
#      Optional: SUPABASE_DB_REGION=us-west-1  (must match your project region in the dashboard)
USE_SUPABASE_DB=true
SUPABASE_DB_REGION=us-west-1
# SUPABASE_POOLER_AWS_CLUSTER=1
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_PROJECT_REF=your-project-ref

# ── Supabase (auth, realtime, storage) ─────────────────────────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# USE_SUPABASE_AUTH=true
# VITE_USE_SUPABASE_AUTH=true
# ALLOW_PUBLIC_SIGNUP=false
# VITE_AUTH_DEBUG=true
# USE_SUPABASE_STORAGE=true
# Optional exact bucket IDs (Dashboard → Storage). If unset, the API matches your buckets by name:
#   church logos, member avatars, event banners
# SUPABASE_BUCKET_CHURCH_LOGOS=church-logos
# SUPABASE_BUCKET_MEMBER_AVATARS=member-avatars
# SUPABASE_BUCKET_EVENT_BANNERS=event-banners
# Media library (audio/video/slides) — created by migration church_media_bucket:
SUPABASE_BUCKET_MEDIA=church-media

# SMTP — password reset & optional task notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourchurch.org
SMTP_NOTIFY=true

# Copy to .env and change in production
JWT_SECRET=your-secure-random-secret-here
PORT=3001
SEED_PASSWORD=ChangeMe123!
APP_URL=http://localhost:8080
# Production (Render): optional — Render sets RENDER_EXTERNAL_URL on Web Services automatically
# APP_URL=https://your-service.onrender.com
CHURCH_NAME=Christ Embassy LCM

# SQLite (default) — comment out DATABASE_URL to use local data/church.db instead
# DATABASE_URL=

# ── Supabase: CEYC CMS (gilcsmnyeuxwuvpxowik) ───────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/gilcsmnyeuxwuvpxowik/settings/database
# Replace [YOUR-PASSWORD] with your database password from Project Settings → Database.
#
# Option A — Direct connection (IPv6; shown in Supabase as "Not IPv4 compatible")
#   host: db.gilcsmnyeuxwuvpxowik.supabase.co | port: 5432 | user: postgres | db: postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.gilcsmnyeuxwuvpxowik.supabase.co:5432/postgres
#
# Option B — Session pooler (IPv4 compatible — CEYC CMS uses aws-1-us-west-1)
# DATABASE_URL=postgresql://postgres.gilcsmnyeuxwuvpxowik:[YOUR-PASSWORD]@aws-1-us-west-1.pooler.supabase.com:5432/postgres
#
DATABASE_SSL=true
SUPABASE_PROJECT_REF=gilcsmnyeuxwuvpxowik

# Supabase Auth + Realtime — anon key is safe for frontend; service role is SERVER ONLY
SUPABASE_URL=https://gilcsmnyeuxwuvpxowik.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_SUPABASE_URL=https://gilcsmnyeuxwuvpxowik.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# SMTP — password reset & optional task notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourchurch.org
SMTP_NOTIFY=true

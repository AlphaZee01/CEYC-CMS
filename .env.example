# Copy to .env and change in production
JWT_SECRET=your-secure-random-secret-here
PORT=3001
SEED_PASSWORD=ChangeMe123!
APP_URL=http://localhost:8080
CHURCH_NAME=Christ Embassy LCM

# SQLite (default) — data stored in data/church.db

# Local JWT auth (default). For Supabase sign-in instead, set both:
# USE_SUPABASE_AUTH=true
# VITE_USE_SUPABASE_AUTH=true

# Optional Supabase — realtime chat works with URL + anon key; auth is opt-in above
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Supabase Storage for uploads in production
# USE_SUPABASE_STORAGE=true

# SMTP — password reset & optional task notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourchurch.org
SMTP_NOTIFY=true
